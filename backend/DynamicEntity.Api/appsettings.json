{
  "SqlServer": {
    "ControlDatabaseConnectionString": "Server=(localdb)\\MSSQLLocalDB;Database=DynamicEntityControl;Integrated Security=true;TrustServerCertificate=true",
    "AnalyticsCommandTimeoutSeconds": 30
  },
  "AlertNotifications": {
    "Email": {
      "Host": "",
      "Port": 587,
      "EnableSsl": true,
      "FromAddress": "",
      "FromDisplayName": "Dynamic Entity Alerts",
      "TimeoutSeconds": 30
    },
    "Webhook": {
      "TimeoutSeconds": 10,
      "AllowPrivateNetworks": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
